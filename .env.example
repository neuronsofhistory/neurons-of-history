# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# The publishable key is safe to expose in the browser; access is controlled by Row Level Security.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
